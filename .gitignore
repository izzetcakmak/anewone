# The vendored web3auth bundle is committed, so its build recipe has to be too —
# otherwise nobody can reproduce or audit 1.4MB of code that touches wallets.
# Everything here except the recipe (and never node_modules) stays ignored.
build-web3auth/*
!build-web3auth/package.json
!build-web3auth/package-lock.json
!build-web3auth/entry.mjs
!build-web3auth/shim.mjs
build-video/
monitor/bridge-attestation.json
monitor/snapshot-cache.json
monitor/snapshot-run.log
monitor/state-cache.json
.vercel
monitor/floor-cache.json
monitor/state.json.bak
# Same for the Circle onramp bundle (docs/vendor/onramp-kit.js): recipe in, node_modules out.
build-onramp/*
!build-onramp/package.json
!build-onramp/package-lock.json
!build-onramp/entry.mjs
!build-onramp/build.mjs
