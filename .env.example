# Deployer private key (0x-prefixed)
PRIVATE_KEY=
# Optional curve params (18-decimal native USDC units)
VIRTUAL_USDC0=4000000000000000000000
GRAD_TARGET=5000000000000000000000
# Optional second owner address — granted owner rights (shared platform-fee pool) at deploy.
# This is a PUBLIC address only; never put a private key here.
SECOND_OWNER=
# Telegram notifications for the mainnet scanner (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Deployer public address (used by the scanner for balance checks and the CCTP bridge)
DEPLOYER_ADDRESS=
# CCTP auto-bridge: USDC moved Base -> Arc the moment mainnet is detected (6-decimal units on Base)
BRIDGE_AMOUNT_USDC=10
# Dev buy made inside the createToken tx, in whole USDC (native, 18 decimals on Arc)
DEV_BUY_USDC=9
# Optional: mint recipient on Arc if different from DEPLOYER_ADDRESS (public address)
MINT_RECIPIENT=
# Set to 1 to disable the automatic CCTP bridge (manual funding)
BRIDGE_DISABLE=

# ---- Deck Hand, the chat that remembers (api/chat.js) ----
# Walrus Memory delegate credentials from https://memory.walrus.xyz (mainnet). Server-side only.
MEMWAL_PRIVATE_KEY=
MEMWAL_ACCOUNT_ID=
# Relayer; the Walrus Foundation hosts the mainnet one and pays the storage.
MEMWAL_SERVER_URL=https://relayer.memory.walrus.xyz
# OpenAI-compatible chat model. Default is Groq + Qwen3.8 27B (not Claude, not GPT).
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=qwen/qwen3.8-27b
# The anonymous assistant on the home page (api/chat.js, mode "site") can run on its own model: Groq meters tokens per
# model, so its questions then never draw on the memory chat's allowance. Production uses the open-weight gpt-oss-20b.
# Leave it out to use LLM_MODEL.
LLM_MODEL_SITE=openai/gpt-oss-20b

# ---- Buy USDC with card (api/onramp-session.js, Circle Onramp Kit) ----
# Circle Console -> Onramp -> API keys. The value is used verbatim as a bearer token and looks
# like TEST_API_KEY:<keyId>:<secret> or LIVE_API_KEY:<keyId>:<secret>. Server-side only; while
# it is unset the "Buy USDC with card" button is not rendered at all (api/onramp-config.js).
ONRAMP_API_KEY=
# Bare hostname of the page that embeds the widget (no scheme, port or path). It is sealed into
# every session so the payment provider accepts anewone.xyz as a frame ancestor.
ONRAMP_REFERRER_DOMAIN=anewone.xyz
# Chain the widget is pinned to for USDC: arc (mainnet) or arc-testnet.
ONRAMP_CHAIN=arc

# ---- Selling to agents: the x402 paywall on /api/agent (api/_x402.js) ----
# The wallet that collects the per-call USDC (buyers see it as payTo). A wallet of its own that
# holds nothing else; it is sanctions-screened when the service is listed in Circle's marketplace.
# While it is unset, /api/agent's priced endpoints answer 503 and /api/basedbot stays the free index.
X402_PAY_TO=
# Keyless trial: the private key of X402_PAY_TO, used ONLY to sign Facilitator-Seller-Proof headers
# (EIP-712, never a transaction). Production instead sets CIRCLE_API_KEY from Circle Console and
# leaves this empty.
X402_SELLER_KEY=
CIRCLE_API_KEY=
# Where buyers may pay, comma-separated CAIP-2 ids among eip155:5042 (Arc), eip155:8453 (Base),
# eip155:137 (Polygon PoS); eip155:5042002 is Arc testnet for the rehearsal. Default: Arc.
X402_NETWORKS=eip155:5042
# Optional price overrides in USDC 6-decimal units, JSON by route: {"tokens":"1000","candles":"2000"}
X402_PRICES=
